# Local examples only. Use real secrets through your hosting environment.
DATABASE_URL=postgresql://remote:change-me@localhost:5432/remote?schema=public
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PORT=3000
# Production defaults to one trusted proxy hop for Render; development to zero.
# Override only to match your actual deployment proxy chain (integer 0–5).
# TRUST_PROXY_HOPS=1

# Optional email delivery. EMAIL_FROM must be verified with Brevo.
BREVO_API_KEY=
EMAIL_FROM=

# Optional Uganda mobile money. Keep test/live configurations separate.
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_WEBHOOK_SIGNATURE_MODE=legacy
# Operator-approved organization-to-landlord collection subaccount mapping.
FLW_ORGANIZATION_SUBACCOUNTS={}
